---
import SeriesCard from "@components/features/posts/SeriesCard.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async ({ paginate }) => {
	return paginate([], { pageSize: 1 });
}) satisfies GetStaticPaths;
---

<MainGridLayout>
	{/* Series Section */}
	<div class="mb-6 onload-animation" style={`--i: 0; --interval: 50ms;`}>
		<SeriesCard
			title="C++"
			description="A beginner-friendly, chapter-by-chapter guide to learning C++ from scratch."
			image="/assets/img/cpp-history-philosophy.webp"
			url="/cpp/"
			parts={6}
		/>
	</div>
</MainGridLayout>
