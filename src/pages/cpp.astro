---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPostsList } from "@utils/content-utils";

const allPosts = await getSortedPostsList();
const cppPosts = allPosts
  .filter((post) => post.data.category === "C++")
  .sort((a, b) => (a.data.priority ?? 99) - (b.data.priority ?? 99));
---

<MainGridLayout title="Introduction to C++">
  {/* Banner */}
  <div class="relative w-full rounded-[var(--radius-large)] overflow-hidden mb-6">
    <img
      src="/assets/desktop-banner/1.webp"
      alt="C++ Series Banner"
      class="w-full h-48 sm:h-64 object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent"></div>
    <div class="absolute bottom-0 left-0 p-6 sm:p-8">
      <p class="text-sm text-white/70 mb-1">Series · {cppPosts.length} parts</p>
      <h1 class="text-3xl sm:text-4xl font-bold text-white mb-2">Introduction to C++</h1>
      <p class="text-white/80 max-w-xl">A beginner-friendly, chapter-by-chapter guide to learning C++ from scratch.</p>
    </div>
  </div>

  {cppPosts.length === 0 && (
    <div class="card-base px-8 py-6">
      <p class="text-50">No posts in this series yet.</p>
    </div>
  )}

  {/* Chapter Grid */}
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {cppPosts.map((post, index) => {
      const date = new Date(post.data.published);
      const dateStr = date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
      const image = post.data.image || "/assets/home/home.webp";
      return (
        <a
          href={post.url}
          class="group card-base overflow-hidden hover:border-[var(--primary)] transition-all duration-200 flex flex-col"
        >
          {/* Thumbnail */}
          <div class="relative w-full h-40 overflow-hidden bg-[var(--btn-plain-bg)]">
            <img
              src={image}
              alt={post.data.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              loading="lazy"
            />
            <div class="absolute top-2 left-2 w-8 h-8 rounded-full bg-[var(--primary)] flex items-center justify-center text-white font-bold text-xs">
              {index + 1}
            </div>
          </div>

          {/* Content */}
          <div class="p-4 flex flex-col flex-1">
            <h2 class="font-bold text-75 group-hover:text-[var(--primary)] transition-colors line-clamp-2 mb-1">
              {post.data.title}
            </h2>
            <p class="text-sm text-50 line-clamp-2 flex-1">{post.data.description}</p>
            <p class="text-xs text-40 mt-2">{dateStr}</p>
          </div>
        </a>
      );
    })}
  </div>
</MainGridLayout>
